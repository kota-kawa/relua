POSTGRES_DB=alljob
POSTGRES_USER=alljob
POSTGRES_PASSWORD=alljob_dev_password
DATABASE_URL=postgresql+psycopg://alljob:alljob_dev_password@db:5432/alljob
REDIS_URL=redis://redis:6379/0
# 90日を超えた監査・確認履歴と再送防止記録の圧縮アーカイブ。専用永続ボリュームをバックアップします。
HISTORY_ARCHIVE_DIR=/var/lib/relua/history-archive
API_INTERNAL_URL=http://api:8000
# 必須。docker-compose は未設定だと起動しません。`local-development-` で始まる値は
# このリポジトリに公開されている既知の値なので、ENVIRONMENT=development のときだけ使えます。
# 生成例: openssl rand -hex 32
API_INTERNAL_TOKEN=local-development-internal-token
# Timeout for server-side API reads, including metadata and sitemap generation.
# For page data reads this is the budget for the whole call, retry included;
# `frontend/proxy.ts` uses the same value for its single request.
API_INTERNAL_TIMEOUT_MS=10000
# 必須。未設定だと起動しません。`/mcp` は公開されるため、本番では必ず固有の値にしてください。
MCP_API_TOKEN=local-development-mcp-token
API_LOOPBACK_PORT=8000
FRONTEND_PORT=3100
# 必須。canonicalにする公開origin（pathなし）。metadata、sitemap、構造化データ、MCPの詳細URLに使われます。
# フロントエンドもAPIも未設定では起動しません。
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# development か production のみ。未設定や綴り違いは起動時エラーになります。
# docker-compose 側の既定は production なので、この行を消すと公開済みの開発用シークレットは拒否されます。
ENVIRONMENT=development

# ChatGPTやClaudeなど、ブラウザ経由で接続する外部MCPクライアントを許可する場合のみ true にします。
MCP_OAUTH_ENABLED=false
# MCPエンドポイントを公開する外部URL。OAuthのissuerとresourceになるため、公開時はhttpsが必須です。
MCP_PUBLIC_URL=http://localhost:8000
# 必須。接続許可画面で入力する運営者パスワード。12文字以上、必ず固有の値に変更してください。
# 未設定だと起動しません。非ASCII（日本語など）も使えます。
MCP_OPERATOR_PASSWORD=local-development-operator-password
MCP_ACCESS_TOKEN_TTL_SECONDS=3600
# 0 はリフレッシュトークンを無期限にし、一度接続したクライアントを再ログインなしで使い続けられるようにします。
MCP_REFRESH_TOKEN_TTL_DAYS=0
MCP_AUTHORIZATION_CODE_TTL_SECONDS=120
MCP_LOGIN_RATE_LIMIT_PER_MINUTE=5
MCP_REGISTRATION_RATE_LIMIT_PER_HOUR=20
# uvicorn が X-Forwarded-For を信頼する「直前のホップ」を指定します。ログイン試行回数の集計に使われます。
# docker-compose は `ports: 127.0.0.1:8000:8000` で公開するため、コンテナから見た相手はホストではなく
# dockerブリッジのgateway（172.16.0.0/12）です。127.0.0.1 だけを指定すると全リクエストが同一IPに見え、
# 攻撃者1人が運営者のログイン試行回数を使い切れてしまいます。
# `*` は絶対に使わないでください。クライアントが送った X-Forwarded-For をそのまま信用するため、
# ヘッダを差し替えるだけでIP単位のログイン制限を回避できます。
FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12
