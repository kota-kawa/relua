POSTGRES_DB=alljob
POSTGRES_USER=alljob
POSTGRES_PASSWORD=alljob_dev_password
DATABASE_URL=postgresql+psycopg://alljob:alljob_dev_password@db:5432/alljob
REDIS_URL=redis://redis:6379/0
API_INTERNAL_URL=http://api:8000
API_INTERNAL_TOKEN=local-development-internal-token
# Timeout for server-side API reads, including metadata and sitemap generation.
# For page data reads this is the budget for the whole call, retry included;
# `frontend/proxy.ts` uses the same value for its single request.
API_INTERNAL_TIMEOUT_MS=10000
MCP_API_TOKEN=local-development-mcp-token
API_LOOPBACK_PORT=8000
FRONTEND_PORT=3100
# canonicalにする公開origin（pathなし）。metadata、sitemap、構造化データ、MCPの詳細URLに使われます。
NEXT_PUBLIC_SITE_URL=http://localhost:3100
ENVIRONMENT=development

# ChatGPTやClaudeなど、ブラウザ経由で接続する外部MCPクライアントを許可する場合のみ true にします。
MCP_OAUTH_ENABLED=false
# MCPエンドポイントを公開する外部URL。OAuthのissuerとresourceになるため、公開時はhttpsが必須です。
MCP_PUBLIC_URL=http://localhost:8000
# 接続許可画面で入力する運営者パスワード。12文字以上、必ず固有の値に変更してください。
MCP_OPERATOR_PASSWORD=local-development-operator-password
MCP_ACCESS_TOKEN_TTL_SECONDS=3600
# 0 はリフレッシュトークンを無期限にし、一度接続したクライアントを再ログインなしで使い続けられるようにします。
MCP_REFRESH_TOKEN_TTL_DAYS=0
MCP_AUTHORIZATION_CODE_TTL_SECONDS=120
MCP_LOGIN_RATE_LIMIT_PER_MINUTE=5
MCP_REGISTRATION_RATE_LIMIT_PER_HOUR=20
# リバースプロキシ経由で公開する場合のみ、プロキシのIPを指定します。ログイン試行回数の集計に使われます。
FORWARDED_ALLOW_IPS=127.0.0.1
